{
  "name": "my-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "api:dev": "tsx server/index.ts",
    "db:start": "docker compose up -d db minio",
    "db:migrate": "tsx scripts/with-db.ts npx prisma migrate dev",
    "db:deploy": "tsx scripts/with-db.ts npx prisma migrate deploy",
    "db:generate": "tsx scripts/with-db.ts npx prisma generate",
    "db:check": "tsx scripts/db-check.ts",
    "catalog:validate": "tsx scripts/validate-catalog-source.ts",
    "pathway:audit": "tsx scripts/audit-pathways.ts",
    "ci:lint-baseline": "tsx scripts/lint-baseline.ts",
    "ci:journeys-baseline": "tsx scripts/v2_1/sim-journeys.ts --check",
    "catalog:import": "tsx scripts/import-catalog.ts",
    "audit:diagnostic": "tsx scripts/audit-diagnostic-data.ts",
    "audit:methodology": "tsx scripts/audit-methodology.ts",
    "audit:catalog": "tsx scripts/audit-catalog.ts",
    "audit:catalog-duplicates": "tsx scripts/audit-catalog-duplicates.ts",
    "audit:diagnostic-coverage": "tsx scripts/audit-diagnostic-coverage.ts",
