    "audit:diagnostic-v2": "tsx scripts/audit-diagnostic-v2.ts",
    "simulate:v2-personas": "tsx scripts/simulate-v2-personas.ts",
    "simulate:v2-montecarlo": "tsx scripts/simulate-v2-montecarlo.ts",
    "test:diagnostic": "vitest run src/tests/diagnostic",
    "test:scenarios": "tsx scripts/simulate-diagnostic-cohort.ts",
    "simulate:diagnostic": "tsx scripts/simulate-diagnostic-cohort.ts",
    "test:catalog": "vitest run --no-file-parallelism server/tests/catalog",
    "test:catalog-publishing": "vitest run --no-file-parallelism server/tests/publishing",
    "test:trainer-applications": "vitest run --no-file-parallelism server/tests/trainer/applications.test.ts",
    "test:trainer-change-workflow": "vitest run --no-file-parallelism server/tests/trainer/change-workflow.test.ts",
    "test:permissions": "vitest run --no-file-parallelism server/tests/trainer/permissions.test.ts",
    "test:cohorts": "vitest run --no-file-parallelism server/tests/learning/cohorts.test.ts",
    "test:learning": "vitest run --no-file-parallelism server/tests/learning",
    "test:advisors": "vitest run --no-file-parallelism server/tests/advisors",
    "test:commerce": "vitest run --no-file-parallelism server/tests/commerce",
    "test:notifications": "vitest run --no-file-parallelism server/tests/notifications",
    "test:support": "vitest run --no-file-parallelism server/tests/support",
    "test:reports": "vitest run --no-file-parallelism server/tests/reports",
    "test:e2e": "vitest run --no-file-parallelism server/tests",
    "test:integration": "npm run test:e2e",
    "test:diagnostic-regression": "tsx scripts/test-diagnostic-regression.ts",
    "test": "npm run test:diagnostic && npm run test:scenarios",
    "audit:skill-coverage": "tsx scripts/with-db.ts tsx scripts/audit-skill-coverage-matrix.ts",
    "seed:demo": "tsx scripts/with-db.ts tsx server/db/seed-demo.ts",
    "build:v2_1-overlays": "tsx scripts/build-v2_1-overlays.ts",
    "ci:overlays": "tsx scripts/build-v2-overlays.ts --check && tsx scripts/build-v2_1-overlays.ts --check",
    "ci:coverage-baseline": "tsx scripts/coverage-baseline.ts",
    "a11y:audit": "tsx scripts/a11y-audit.ts",
    "ci:a11y": "tsx scripts/a11y-audit.ts --public",
    "simulate:v2_1-journeys": "tsx scripts/v2_1/sim-journeys.ts",
    "audit:recommendation-universe": "tsx scripts/v2_1/audit-universe.ts",
    "audit:question-waste": "tsx scripts/v2_1/audit-question-waste.ts",
    "audit:confirmation-value": "tsx scripts/v2_1/audit-confirmation-value.ts",
    "ci:question-waste": "tsx scripts/v2_1/audit-question-waste.ts --check",
    "simulate:v2_1-reachability": "tsx scripts/v2_1/golden-suite.ts --montecarlo",
    "report:v2_1-docs": "tsx scripts/v2_1/report-docs.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
