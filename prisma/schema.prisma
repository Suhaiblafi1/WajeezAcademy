// قاعدة بيانات أكاديمية وجيز — PostgreSQL عبر Prisma
// المبدأ الحاكم: المعرفات الثابتة (PW-/C-/TPL-/SK-/QB-) لا تتغير أبدا،
// وكل تعديل منشور يولّد إصدارا جديدا — لا تعديل بأثر رجعي.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/* ═══════════ الهوية والصلاحيات ═══════════ */

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String
  displayName  String
  status       String    @default("active") // active | suspended
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  suspendedAt  DateTime?
  roles        UserRole[]
  sessions     Session[]
  resetTokens  PasswordResetToken[]
  trainerProfile TrainerProfile?
}

model Role {
  id          String           @id // super_admin | academic_manager | diagnostic_manager | operations_manager | advisor | trainer | finance | support | learner
  nameAr      String
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  key         String           @id // catalog.course.edit ...
  description String
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionKey String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)
  @@id([roleId, permissionKey])
}

model UserRole {
  userId String @db.Uuid
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@id([userId, roleId])
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique // لا يُحفظ الرمز ذاته بل هاشه
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LoginAttempt {
  id        String   @id @default(uuid()) @db.Uuid
  email     String
  ip        String?
  success   Boolean
  createdAt DateTime @default(now())
  @@index([email, createdAt])
}

/* ═══════════ إصدارات الكتالوج والنشر ═══════════ */

model CatalogVersion {
  id          String    @id @default(uuid()) @db.Uuid
  label       String    @unique // مثل 2026.08.16-01
  status      String    @default("draft") // draft | published | superseded
  createdBy   String?   @db.Uuid
  createdAt   DateTime  @default(now())
  publishedAt DateTime?
  publishedBy String?   @db.Uuid
  snapshots   CatalogSnapshot[]
  events      CatalogPublishEvent[]
}

model CatalogSnapshot {
  id               String   @id @default(uuid()) @db.Uuid
  catalogVersionId String   @db.Uuid
  payload          Json     // اللقطة المجمدة التي يقرأها محرك التشخيص
  payloadHash      String
  createdAt        DateTime @default(now())
  catalogVersion   CatalogVersion @relation(fields: [catalogVersionId], references: [id], onDelete: Cascade)
  @@index([catalogVersionId])
}

model CatalogPublishEvent {
  id               String   @id @default(uuid()) @db.Uuid
  catalogVersionId String   @db.Uuid
  actorId          String?  @db.Uuid
  action           String   // publish | rollback | schedule
  details          Json?
  createdAt        DateTime @default(now())
  catalogVersion   CatalogVersion @relation(fields: [catalogVersionId], references: [id], onDelete: Cascade)
}

/* ═══════════ الكتالوج الأكاديمي ═══════════ */

model Pathway {
  id              String  @id // PW-BIZ-001 — ثابت لا يتغير
  status          String  @default("draft") // draft|diagnostic_incomplete|diagnostic_ready|in_review|changes_requested|approved|published|paused|archived
  currentVersion  Int     @default(1)
  createdBy       String? @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  versions        PathwayVersion[]
  courses         PathwayCourse[]
  skillRequirements PathwaySkillRequirement[]
}

model PathwayVersion {
  id            String   @id @default(uuid()) @db.Uuid
  pathwayId     String
  version       Int
  title         String
  shortTitle    String?
  audience      String?
  notFor        String?
  entry         String?
  beforeText    String?
  afterText     String?
  durationWeeks Int?
  weeklyHours   String? // نطاق نصي كما في المصدر الموثق: «4–5» — لا يُحوّل لعدد
  level         String?
  delivery      String?
  capstone      String?
  outcomeMetric String?
  credentialAr  String?
  status        String   @default("draft")
  createdBy     String?  @db.Uuid
  createdAt     DateTime @default(now())
  pathway       Pathway  @relation(fields: [pathwayId], references: [id], onDelete: Cascade)
  @@unique([pathwayId, version])
  @@index([pathwayId])
}

model CompositeTemplate {
  id             String  @id // TPL-VENTURE-001
  status         String  @default("draft")
  currentVersion Int     @default(1)
  notCountedAsPathway Boolean @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  versions       CompositeTemplateVersion[]
  courses        TemplateCourse[]
}

model CompositeTemplateVersion {
  id             String   @id @default(uuid()) @db.Uuid
  templateId     String
  version        Int
  nameAr         String
  shortNameAr    String?
  intentAr       String?
  persona        Json?
  transformation Json?
  plan           Json?
  diagnostic     Json?
  status         String   @default("draft")
  createdBy      String?  @db.Uuid
  createdAt      DateTime @default(now())
  template       CompositeTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  @@unique([templateId, version])
}

model Course {
  id                    String  @id // C-BIZ-101 — ثابت حتى عند تغيير الاسم
  status                String  @default("draft") // draft|in_review|approved|published|paused|archived
  currentVersion        Int     @default(1)
  recommendableDirectly Boolean @default(false)
  priceUsd              Int?
  availability          String  @default("available") // available | waitlist | retired
  createdBy             String? @db.Uuid
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  versions              CourseVersion[]
  modules               CourseModule[]
  skillLinks            CourseSkillLink[]
  pathwayLinks          PathwayCourse[]
  templateLinks         TemplateCourse[]
  prerequisites         Prerequisite[] @relation("CoursePrereq")
  requiredBy            Prerequisite[] @relation("PrereqOf")
  trainerQualifications TrainerCourseQualification[]
  trainerAssignments    TrainerCourseAssignment[]
  trainerChangeRequests TrainerChangeRequest[]
  cohorts               Cohort[]
}

model CourseVersion {
  id             String   @id @default(uuid()) @db.Uuid
  courseId       String
  version        Int
  titleAr        String
  legacyTitleAr  String?
  shortPromiseAr String?
  descriptionAr  String?
  audienceAr     String?
  prerequisitesAr String?
  levelAr        String?
  totalHours     Int
  weeklyHours    Int?
  deliveryAr     String?
  languageAr     String?  @default("العربية")
  trainerRequirements Json?
  status         String   @default("draft")
  createdBy      String?  @db.Uuid
  createdAt      DateTime @default(now())
  course         Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  objectives     LearningObjective[]
  outcomes       LearningOutcome[]
  project        PracticalProject?
  assessments    Assessment[]
  @@unique([courseId, version])
  @@index([courseId])
}

model CourseModule {
  id        String  @id // C-BIZ-101-M1 — ثابت
  courseId  String
  status    String  @default("published") // draft|published|archived — المستخدمة في شعبة لا تُحذف بل تؤرشف
  createdAt DateTime @default(now())
  course    Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  versions  CourseModuleVersion[]
  @@index([courseId])
}

model CourseModuleVersion {
  id         String   @id @default(uuid()) @db.Uuid
  moduleId   String
  version    Int
  sequence   Int
  titleAr    String
  outcomeAr  String?
  activityAr String?
  artifactAr String?
  hours      Int
  status     String   @default("published")
  createdAt  DateTime @default(now())
  module     CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  @@unique([moduleId, version])
}

model LearningObjective {
  id              String @id @default(uuid()) @db.Uuid
  courseVersionId String @db.Uuid
  sequence        Int
  textAr          String
  courseVersion   CourseVersion @relation(fields: [courseVersionId], references: [id], onDelete: Cascade)
  @@index([courseVersionId])
}

model LearningOutcome {
  id              String @id @default(uuid()) @db.Uuid
  courseVersionId String @db.Uuid
  sequence        Int
  textAr          String
  courseVersion   CourseVersion @relation(fields: [courseVersionId], references: [id], onDelete: Cascade)
  @@index([courseVersionId])
}

model PracticalProject {
  id              String @id @default(uuid()) @db.Uuid
  courseVersionId String @unique @db.Uuid
  descriptionAr   String
  evidenceRequired Json?
  courseVersion   CourseVersion @relation(fields: [courseVersionId], references: [id], onDelete: Cascade)
}

model Assessment {
  id              String @id @default(uuid()) @db.Uuid
  courseVersionId String @db.Uuid
  kind            String // summative | formative | project_review
  specAr          String?
  courseVersion   CourseVersion @relation(fields: [courseVersionId], references: [id], onDelete: Cascade)
  rubrics         Rubric[]
}

model Rubric {
  id           String  @id @default(uuid()) @db.Uuid
  assessmentId String? @db.Uuid
  nameAr       String
  criteria     Json    // [{criterion_ar, weight, levels:[...]}]
  assessment   Assessment? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
}

/* ═══════════ المهارات ═══════════ */

model Skill {
  id              String  @id // SK-...
  slug            String  @unique
  nameAr          String
  familyId        String? // رمز العائلة من المصدر: COG, AUT ...
  definitionAr    String?
  aliases         Json?   // أسماء بديلة
  domain          String?
  source          String? // مصدر التصنيف
  masteryScale    Json?
  evidenceExamples Json?
  status          String  @default("published")
  currentVersion  Int     @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  versions        SkillVersion[]
  relations       SkillRelation[] @relation("SkillFrom")
  courseLinks     CourseSkillLink[]
  pathwayReqs     PathwaySkillRequirement[]
  questionLinks   QuestionSkillLink[]
}

model SkillVersion {
  id        String   @id @default(uuid()) @db.Uuid
  skillId   String
  version   Int
  nameAr    String
  definitionAr String?
  status    String   @default("draft")
  createdBy String?  @db.Uuid
  createdAt DateTime @default(now())
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  @@unique([skillId, version])
}

model SkillRelation {
  skillId        String
  relatedSkillId String
  type           String // broader | narrower | related | prerequisite
  skill          Skill   @relation("SkillFrom", fields: [skillId], references: [id], onDelete: Cascade)
  @@id([skillId, relatedSkillId, type])
}

model CourseSkillLink {
  courseId    String
  skillId     String
  targetLevel Int     @default(3)
  weight      Float   @default(1)
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  skill       Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  @@id([courseId, skillId])
}

model PathwaySkillRequirement {
  pathwayId     String
  skillId       String
  requiredLevel Int    @default(3)
  priority      String @default("medium") // high | medium | low
  weight        Float  @default(1)
  pathway       Pathway @relation(fields: [pathwayId], references: [id], onDelete: Cascade)
  skill         Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)
  @@id([pathwayId, skillId])
}

model PathwayCourse {
  pathwayId String
  courseId  String
  sequence  Int
  kind      String @default("required") // required | optional | gift
  pathway   Pathway @relation(fields: [pathwayId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  @@id([pathwayId, courseId])
  @@index([courseId])
}

model TemplateCourse {
  templateId String
  courseId   String
  listType   String // required | conditional | bridge | starter
  sequence   Int    @default(1)
  roleAr     String?
  reasonAr   String?
  conditionAr String?
  template   CompositeTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  course     Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  @@id([templateId, courseId, listType])
  @@index([courseId])
}

model Prerequisite {
  courseId         String
  requiresCourseId String
  course           Course @relation("CoursePrereq", fields: [courseId], references: [id], onDelete: Cascade)
  requires         Course @relation("PrereqOf", fields: [requiresCourseId], references: [id], onDelete: Cascade)
  @@id([courseId, requiresCourseId])
}

model MethodologyReference {
  code       String  @id // REF-...
  titleAr    String
  publisherAr String?
  url        String?
  status     String  @default("implemented")
  evidenceAr String?
  createdAt  DateTime @default(now())
}

/* ═══════════ بنك الأسئلة ═══════════ */

model Question {
  id               String  @id // QB-M0-001 — ثابت
  moduleId         String?
  moduleName       String?
  answerType       String
  optionsKey       String?
  personaScope     Json     @default("[]")
  measures         Json
  triggerCondition String  @default("always")
  reasonAr         String? // سبب اختيار السؤال
  differentiates   Json?   // مرشحو التعادل الذين يفرق بينهم
  sensitivityLevel String  @default("low")
  requiredLevel    String  @default("core")
  weight           Float   @default(1)
  active           Boolean @default(true)
  status           String  @default("published")
  currentVersion   Int     @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  versions         QuestionVersion[]
  options          QuestionOption[]
  skillLinks       QuestionSkillLink[]
}

model QuestionVersion {
  id         String   @id @default(uuid()) @db.Uuid
  questionId String
  version    Int
  textAr     String
  status     String   @default("draft")
  createdBy  String?  @db.Uuid
  createdAt  DateTime @default(now())
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  @@unique([questionId, version])
}

model QuestionOption {
  id         String  @id @default(uuid()) @db.Uuid
  questionId String
  optionId   String  // o1, o2 ... ثابت — لا يُستخدم النص العربي مفتاح قرار
  orderIndex Int
  textAr     String
  effects    Json?   // أثر الخيار على الحقائق والأوزان
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  @@unique([questionId, optionId])
  @@unique([questionId, orderIndex])
}

model QuestionSkillLink {
  questionId String
  skillId    String
  weight     Float  @default(1)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  skill      Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  @@id([questionId, skillId])
}

/* ═══════════ الملفات التشخيصية والتقييم ═══════════ */

model DiagnosticProfile {
  id              String  @id @default(uuid()) @db.Uuid
  entityType      String  // pathway | template | course
  entityId        String
  audience        Json?
  goals           Json?
  requiredSkills  Json?   // [{skill_id, target_level, weight, priority}]
  interests       Json?
  timeConstraints Json?
  eligibility     Json?
  exclusion       Json?
  positiveSignals Json?
  negativeSignals Json?
  differentiators Json?
  minCoverage     Float   @default(0.8)
  rationales      Json?
  readinessStatus String  @default("incomplete") // incomplete | diagnostic_ready
  profile         Json?   // اللقطة الكاملة لملف المصدر (personas/goals/sectors/functions/...) بلا اقتطاع
  version         Int     @default(1)
  updatedAt       DateTime @updatedAt
  @@unique([entityType, entityId])
}

model ScoringConfigVersion {
  id          String    @id @default(uuid()) @db.Uuid
  version     Int       @unique
  config      Json
  status      String    @default("draft") // draft | published | superseded
  createdBy   String?   @db.Uuid
  createdAt   DateTime  @default(now())
  publishedAt DateTime?
}

model RecommendationVersion {
  id          String    @id @default(uuid()) @db.Uuid
  version     Int       @unique
  rules       Json
  status      String    @default("draft")
  createdBy   String?   @db.Uuid
  createdAt   DateTime  @default(now())
  publishedAt DateTime?
}

model SlugRedirect {
  oldSlug    String   @id
  entityType String   // course | pathway
  entityId   String
  createdAt  DateTime @default(now())
}

/* ═══════════ الحوكمة: طلبات التغيير والمراجعة ═══════════ */

model ContentChangeRequest {
  id          String    @id @default(uuid()) @db.Uuid
  entityType  String    // pathway | course | skill | question | template
  entityId    String
  payload     Json      // التعديل المقترح
  status      String    @default("draft") // draft | in_review | changes_requested | approved | rejected | applied
  createdBy   String?   @db.Uuid
  createdAt   DateTime  @default(now())
  reviewedBy  String?   @db.Uuid
  reviewedAt  DateTime?
  comments    ContentReviewComment[]
  decisions   ContentApprovalDecision[]
}

model ContentReviewComment {
  id              String   @id @default(uuid()) @db.Uuid
  changeRequestId String   @db.Uuid
  authorId        String?  @db.Uuid
  bodyAr          String
  createdAt       DateTime @default(now())
  changeRequest   ContentChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
}

model ContentApprovalDecision {
  id              String   @id @default(uuid()) @db.Uuid
  changeRequestId String   @db.Uuid
  actorId         String?  @db.Uuid
  decision        String   // approve | request_changes | reject
  noteAr          String?
  createdAt       DateTime @default(now())
  changeRequest   ContentChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
}

model ImpactAnalysisRun {
  id          String   @id @default(uuid()) @db.Uuid
  changeRef   String   // وصف أو معرف التغيير
  summary     Json     // ما تغير + المتأثرون + نتائج المحاكاة قبل/بعد
  createdBy   String?  @db.Uuid
  createdAt   DateTime @default(now())
}

model DiagnosticRegressionRun {
  id               String   @id @default(uuid()) @db.Uuid
  catalogVersionId String?  @db.Uuid
  results          Json     // 12 شخصية × توصية × ثقة × حتمية
  passed           Boolean
  createdAt        DateTime @default(now())
}

/* ═══════════ جلسات التشخيص — الأثر التاريخي ═══════════ */

model DiagnosticSession {
  id                     String   @id @default(uuid()) @db.Uuid
  userId                 String?  @db.Uuid
  catalogVersionId       String?  @db.Uuid
  engineVersion          String
  questionBankVersion    String?
  scoringConfigVersion   Int?
  recommendationVersion  Int?
  answers                Json
  decisionTrace          Json
  candidates             Json?    // المرشحون المقيَّمون ودرجاتهم
  exclusionReasons       Json?
  recommendationSnapshot Json     // لقطة النتيجة كما عُرضت — لا تتغير بأثر رجعي
  createdAt              DateTime @default(now())
  @@index([userId])
  @@index([catalogVersionId])
}

/* ═══════════ منظومة المدربين — من الطلب العام إلى الاعتماد والنشر ═══════════
   الحاكمية: قبول الطلب ≠ إنشاء الحساب ≠ تفعيل الدور ≠ التأهيل لدورة ≠ التعيين ≠ النشر العام.
   كل انتقال حالة يُسجَّل في TrainerStatusHistory، وكل إجراء حساس في AuditEvent. */

model TrainerApplication {
  id                  String    @id @default(uuid()) @db.Uuid
  reference           String    @unique // WJ-TR-2026-00001
  status              String    @default("email_verification_pending")
  // draft | email_verification_pending | submitted | under_review | information_requested
  // | shortlisted | interview_scheduled | demo_requested | academic_review
  // | conditionally_approved | contract_pending | onboarding | active
  // | waitlisted | rejected | withdrawn | suspended
  email               String
  emailVerifiedAt     DateTime?
  emailVerifyTokenHash String?  @unique // رمز تحقق البريد — هاش فقط
  emailVerifyExpiresAt DateTime?
  accessTokenHash     String?   @unique // رمز وصول المرشح لمرحلة الاستكمال — هاش فقط
  // المرحلة الأولى
  fullName            String
  phoneCountryCode    String?
  phone               String?
  country             String?
  timezone            String?
  jobTitle            String?
  domainYears         String?   // 1-3 | 4-7 | 8-12 | 12+
  trainingYears       String?   // خبرة التدريب منفصلة عن خبرة المجال
  bio                 String?
  linkedinUrl         String?
  trainingLanguages   String[]  @default([])
  deliveryMode        String?   // in_person | remote | both
  motivation          String?
  privacyConsentAt    DateTime?
  // المرحلة الثانية — تُفتح للمرشحين فقط
  phase2CompletedAt   DateTime?
  previousCourses     Json?     // [{title, org, year, learnersCount}] — حتى ثلاث
  totalLearners       Int?
  previousOrgs        String?
  evidenceNotes       String?
  availability        Json?     // {days, hoursPerWeek, startFrom}
  demoConsent         Boolean   @default(false)
  teachableCourseIds  String[]  @default([]) // الدورات الحالية التي يستطيع تدريسها
  withdrawReason      String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  specialties         TrainerApplicationSpecialty[]
  documents           TrainerApplicationDocument[]
  reviews             TrainerApplicationReview[]
  interviews          TrainerInterview[]
  demoEvaluations     TrainerDemoEvaluation[]
  references          TrainerReference[]
  statusHistory       TrainerStatusHistory[]
  invitations         TrainerInvitation[]
  profile             TrainerProfile?
  @@index([status, createdAt])
  @@index([email])
}

model TrainerApplicationSpecialty {
  applicationId String             @db.Uuid
  specialty     String
  application   TrainerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  @@id([applicationId, specialty])
}

model TrainerApplicationDocument {
  id            String             @id @default(uuid()) @db.Uuid
  applicationId String             @db.Uuid
  kind          String             // cv | training_video | certificate | evidence | reference_letter | other
  storageKey    String             @unique // مفتاح تخزين خاص — لا يُقدَّم إلا برابط موقع مؤقت
  originalName  String
  mime          String
  sizeBytes     Int
  uploadedAt    DateTime           @default(now())
  application   TrainerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  @@index([applicationId])
}

model TrainerApplicationReview {
  id            String             @id @default(uuid()) @db.Uuid
  applicationId String             @db.Uuid
  reviewerId    String             @db.Uuid
  scores        Json               // {domain_expertise, evidence, facilitation, demo_quality, activity_design, feedback_skill, digital_training, values_fit, availability} 1-5
  overallNote   String?
  createdAt     DateTime           @default(now())
  application   TrainerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  @@index([applicationId])
}

model TrainerInterview {
  id            String             @id @default(uuid()) @db.Uuid
  applicationId String             @db.Uuid
  scheduledAt   DateTime
  mode          String             @default("remote") // remote | in_person
  interviewerId String?            @db.Uuid
  outcome       String?            // passed | hold | failed
  notes         String?
  createdAt     DateTime           @default(now())
  application   TrainerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  @@index([applicationId])
}

model TrainerDemoEvaluation {
  id            String             @id @default(uuid()) @db.Uuid
  applicationId String             @db.Uuid
  evaluatorId   String             @db.Uuid
  scores        Json               // نفس محاور الروبرك البشري
  decision      String?            // pass | retry | fail
  notes         String?
  createdAt     DateTime           @default(now())
  application   TrainerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  @@index([applicationId])
}

model TrainerReference {
  id            String             @id @default(uuid()) @db.Uuid
  applicationId String             @db.Uuid
  name          String
  relation      String?
  contact       String?
  note          String?
  verifiedAt    DateTime?
  verifiedBy    String?            @db.Uuid
  createdAt     DateTime           @default(now())
  application   TrainerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  @@index([applicationId])
}

model TrainerStatusHistory {
  id            String             @id @default(uuid()) @db.Uuid
  applicationId String             @db.Uuid
  fromStatus    String?
  toStatus      String
  actorId       String?            @db.Uuid // null = النظام
  note          String?
  createdAt     DateTime           @default(now())
  application   TrainerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  @@index([applicationId, createdAt])
}

model TrainerInvitation {
  id            String             @id @default(uuid()) @db.Uuid
  applicationId String             @db.Uuid
  tokenHash     String             @unique // لا يُحفظ الرمز ذاته
  sentTo        String
  expiresAt     DateTime
  usedAt        DateTime?
  createdBy     String?            @db.Uuid
  createdAt     DateTime           @default(now())
  application   TrainerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  @@index([applicationId])
}

model TrainerOnboardingTask {
  profileId   String          @db.Uuid
  key         String          // sign_contract | academy_orientation | lms_setup | first_cohort_brief ...
  title       String
  doneAt      DateTime?
  createdAt   DateTime        @default(now())
  profile     TrainerProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  @@id([profileId, key])
}

model TrainerProfile {
  id                 String    @id @default(uuid()) @db.Uuid
  applicationId      String    @unique @db.Uuid
  userId             String?   @unique @db.Uuid // يُربط فقط عبر الدعوة الآمنة — المتقدم لا يمنح نفسه الدور
  headline           String?
  bioPublic          String?
  isVerified         Boolean   @default(false) // ملف موثق
  publicVisibility   Boolean   @default(false) // لا يظهر للعامة إلا بموافقة نشر
  publishApprovedBy  String?   @db.Uuid
  publishApprovedAt  DateTime?
  suspendedAt        DateTime?
  suspendedBy        String?   @db.Uuid
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  application        TrainerApplication       @relation(fields: [applicationId], references: [id])
  user               User?                  @relation(fields: [userId], references: [id])
  skills             TrainerSkill[]
  qualifications     TrainerCourseQualification[]
  assignments        TrainerCourseAssignment[]
  changeRequests     TrainerChangeRequest[]
  onboardingTasks    TrainerOnboardingTask[]
  contracts          TrainerContract[]
  compensationRules  TrainerCompensationRule[]
  payouts            TrainerPayout[]
  cohortPlans        CohortDeliveryPlan[]
}

model TrainerSkill {
  profileId String         @db.Uuid
  skillId   String
  level     Int            @default(3) // 1-5
  profile   TrainerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  @@id([profileId, skillId])
}

model TrainerCourseQualification {
  id          String         @id @default(uuid()) @db.Uuid
  profileId   String         @db.Uuid
  courseId    String
  status      String         @default("qualified") // qualified | pending | retired
  qualifiedBy String?        @db.Uuid
  note        String?
  createdAt   DateTime       @default(now())
  profile     TrainerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  course      Course         @relation(fields: [courseId], references: [id])
  @@unique([profileId, courseId])
}

model TrainerCourseAssignment {
  id         String         @id @default(uuid()) @db.Uuid
  profileId  String         @db.Uuid
  courseId   String
  cohortId   String?        @db.Uuid
  status     String         @default("active") // active | completed | cancelled
  assignedBy String?        @db.Uuid
  createdAt  DateTime       @default(now())
  profile    TrainerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  course     Course         @relation(fields: [courseId], references: [id])
  cohort     Cohort?        @relation(fields: [cohortId], references: [id])
  @@index([profileId, status])
}

model TrainerChangeRequest {
  id                 String          @id @default(uuid()) @db.Uuid
  profileId          String          @db.Uuid
  courseId           String
  baseCourseVersion  Int             // الإصدار الأساسي الذي بُني عليه الاقتراح
  scope              String          // cohort | catalog
  cohortId           String?         @db.Uuid
  status             String          @default("draft")
  // draft | submitted | under_review | changes_requested | approved_for_cohort
  // | approved_for_catalog | rejected | withdrawn | published | superseded
  reason             String
  evidence           String?
  scheduledPublishAt DateTime?
  reviewedBy         String?         @db.Uuid
  reviewedAt         DateTime?
  reviewerComment    String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  profile            TrainerProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  course             Course          @relation(fields: [courseId], references: [id])
  cohort             Cohort?         @relation(fields: [cohortId], references: [id])
  items              TrainerChangeRequestItem[]
  @@index([status, createdAt])
}

model TrainerChangeRequestItem {
  id          String              @id @default(uuid()) @db.Uuid
  requestId   String              @db.Uuid
  changeType  String              // module_title_edit | module_add | module_reorder | explanation_improve
                                  // | material_add | activity_add | assignment_add | assessment_improve
                                  // | examples_update | duration_propose | project_propose | outcome_propose
  targetKey   String?             // مثل معرف الوحدة C-XXX-001-M2
  beforeValue Json?
  afterValue  Json?
  note        String?
  request     TrainerChangeRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  @@index([requestId])
}

model TrainerContract {
  id        String         @id @default(uuid()) @db.Uuid
  profileId String         @db.Uuid
  title     String
  terms     Json?          // شروط التعاقد المهيكلة
  status    String         @default("draft") // draft | sent | signed | expired | terminated
  sentAt    DateTime?
  signedAt  DateTime?
  createdBy String?        @db.Uuid
  createdAt DateTime       @default(now())
  profile   TrainerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  @@index([profileId])
}

model TrainerCompensationRule {
  id             String         @id @default(uuid()) @db.Uuid
  profileId      String         @db.Uuid
  type           String         // per_seat | fixed_per_cohort | revenue_share
  rate           Decimal        @db.Decimal(10, 2)
  currency       String         @default("JOD")
  effectiveFrom  DateTime       @default(now())
  effectiveTo    DateTime?
  createdBy      String?        @db.Uuid
  createdAt      DateTime       @default(now())
  profile        TrainerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  @@index([profileId])
}

model TrainerPayout {
  id         String         @id @default(uuid()) @db.Uuid
  profileId  String         @db.Uuid
  period     String         // مثل 2026-08
  status     String         @default("pending") // pending | approved | paid | cancelled
  total      Decimal        @default(0) @db.Decimal(10, 2)
  currency   String         @default("JOD")
  approvedBy String?        @db.Uuid
  paidAt     DateTime?
  createdAt  DateTime       @default(now())
  profile    TrainerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  items      TrainerPayoutItem[]
  @@index([profileId, period])
}

model TrainerPayoutItem {
  id          String        @id @default(uuid()) @db.Uuid
  payoutId    String        @db.Uuid
  description String
  amount      Decimal       @db.Decimal(10, 2)
  sourceRef   String?       // مرجع الشعبة أو الدورة
  payout      TrainerPayout @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  @@index([payoutId])
}

/* ═══════════ الشعب وخطط التنفيذ — فصل المخطط الأساسي عن خطة الشعبة ═══════════
   Canonical Course Blueprint = Course + CourseVersion + CourseModule (قائم أصلا).
   CohortDeliveryPlan = مدرب الشعبة ومواعيدها وأمثلتها وموادها الإضافية وأنشطتها —
   يمكن اعتماد اقتراح لشعبة واحدة دون تغيير الكتالوج. */

model Cohort {
  id        String    @id @default(uuid()) @db.Uuid
  courseId  String
  pathwayId String?
  title     String
  status    String    @default("draft") // draft | published | open | running | completed | cancelled
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  course    Course    @relation(fields: [courseId], references: [id])
  plans     CohortDeliveryPlan[]
  assignments TrainerCourseAssignment[]
  changeRequests TrainerChangeRequest[]
  @@index([courseId, status])
}

model CohortDeliveryPlan {
  id         String          @id @default(uuid()) @db.Uuid
  cohortId   String          @db.Uuid
  trainerId  String?         @db.Uuid
  content    Json            // {schedule, examples, extraMaterials, activities, ordering}
  status     String          @default("draft") // draft | approved | published | superseded
  sourceChangeRequestId String? @db.Uuid // إن نُشرت من اقتراح مدرب بنطاق شعبة
  createdBy  String?         @db.Uuid
  createdAt  DateTime        @default(now())
  cohort     Cohort          @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  trainer    TrainerProfile? @relation(fields: [trainerId], references: [id])
  @@index([cohortId, status])
}

/* ═══════════ سجل التدقيق العام — كل إجراء حساس ═══════════ */

model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid // null = النظام
  action     String   // trainer.application.submit | trainer.status.transition | trainer.change.decide ...
  entityType String
  entityId   String
  meta       Json?
  createdAt  DateTime @default(now())
  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}
