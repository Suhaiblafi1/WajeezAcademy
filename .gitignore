node_modules/
dist/
*.log
.DS_Store

# لقطات الفحص المحلية
verification/

# سكربتات الفحص المؤقتة — لا تدخل Git
scripts/tmp/

# أسرار البيئة وبيانات PostgreSQL المدمج المحلية
.env
.pgdata/

# تخزين وثائق المتقدمين الخاص — لا يدخل Git أبدا
storage/private/
.vercel
.env*
# والقوالب وحدها تُرفع: تحمل أسماء المتغيّرات لا قيمها، وغيابها يجعل
# الإعداد تخمينا. الاستثناء بلاحقة .example صراحةً فلا يتسرّب ملفٌّ حقيقيّ.
!.env.example
!*.env.example
!deploy/.env.production.example

# أدوات الوكيل المحلية — لا تُرفع للمستودع
.agents/
skills-lock.json

# إعدادات كلود: الشخصي منها لا يُرفع، والمشترك يُرفع.
# settings.local.json إذنٌ محلي لكل جهاز — رفعُه يفرض إذن أحدنا على الباقين.
# و.claude/skills تعليماتٌ يتبعها الوكيل على هذا المستودع: لو بقيت مُهمَلة
# لعاشت في حاوية جلسة واحدة وماتت معها، ولما رآها مراجع في أي طلب دمج —
# وهي أَولى ما يُراجَع، لأنها تُوجّه من يكتب الكود لا الكود نفسه.
.claude/*
!.claude/skills/
# و.claude/agents وكلاءُ فرعيّون تستدعيهم مهارةٌ مثبَّتة بالاسم. لو بقوا
# مُهمَلين لَما وجدتهم المهارةُ عند الاستدعاء، ولسقطت إلى مسارها المتدهور.
!.claude/agents/

# Python bytecode from imported skill tools
__pycache__/
*.pyc

# مساحاتُ عملٍ تكتبها المهاراتُ المستوردة وقتَ التشغيل — لا تدخل Git.
# .superpowers/sdd يُهمِل نفسه بملفٍّ يكتبه سكربتُه، و.superpowers/brainstorm
# لا يفعل. والتصريحُ هنا يغطّي الاثنين فلا يتعلَّق الأمر بترتيب التشغيل.
.superpowers/
# و.impeccable/live حالةُ جلسةِ متصفِّحٍ عابرة. أمّا .impeccable/config.json
# و design.json فسياقُ مشروعٍ دائم يُرفع عن قصد، فلا يُهمَل المجلَّد كلُّه.
.impeccable/live/

# مخرجاتُ الفحص لا تُلتزَم: ١٢٥ لقطةً بـ١٣ ميغابايت كانت في المستودع، ولا
# سطرَ يقرؤها. اللقطةُ دليلٌ على لحظتها، وتُنتَج بأمرٍ واحدٍ متى احتيج إليها —
# فحفظُها يُثقل كلَّ استنساخٍ ويُوهم أنّها مرجع. وأدلّةُ التقارير المقصودةُ
# تحت `docs/audit-2026-09/tour/` تبقى: مُختارةٌ ومضغوطةٌ ومُشارٌ إليها بالنصّ.
audit/*.png
audit/*.jpg

# نتيجةُ اختبارات الخادم — تُكتب في كلّ تشغيلٍ ويقرأها حاجزُها
.vitest-server-results.json

# ختمُ البناء — يُولَّد عند كل بناء ويصف نسخةَ الجهاز الذي بُني عليه
build-stamp.json
