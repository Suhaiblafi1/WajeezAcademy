node_modules/
dist/
*.log
.DS_Store

# لقطات الفحص المحلية
verification/

# سكربتات الفحص المؤقتة — لا تدخل Git
scripts/tmp/

# أسرار البيئة وبيانات PostgreSQL المدمج المحلية
.env
.pgdata/

# تخزين وثائق المتقدمين الخاص — لا يدخل Git أبدا
storage/private/
.vercel
.env*
# والقوالب وحدها تُرفع: تحمل أسماء المتغيّرات لا قيمها، وغيابها يجعل
# الإعداد تخمينا. الاستثناء بلاحقة .example صراحةً فلا يتسرّب ملفٌّ حقيقيّ.
!.env.example
!*.env.example
!deploy/.env.production.example

# أدوات الوكيل المحلية — لا تُرفع للمستودع
.agents/
skills-lock.json

# إعدادات كلود: الشخصي منها لا يُرفع، والمشترك يُرفع.
# settings.local.json إذنٌ محلي لكل جهاز — رفعُه يفرض إذن أحدنا على الباقين.
# و.claude/skills تعليماتٌ يتبعها الوكيل على هذا المستودع: لو بقيت مُهمَلة
# لعاشت في حاوية جلسة واحدة وماتت معها، ولما رآها مراجع في أي طلب دمج —
# وهي أَولى ما يُراجَع، لأنها تُوجّه من يكتب الكود لا الكود نفسه.
.claude/*
!.claude/skills/

# Python bytecode from imported skill tools
__pycache__/
*.pyc
