# Caddy — شهادة TLS تلقائية، وواجهةٌ ساكنة، وواجهةُ برمجةٍ خلفها.
#
# لماذا Caddy لا nginx: الشهادة تُجلب وتُجدَّد بلا تدخّل. وانتهاءُ الشهادة هو
# أكثر ما قد يوقف webhooks سترايب بصمت — فمالٌ يُقبض ولا تسجيل يُنشأ. إخراج
# التجديد من يد الإنسان ليس رفاهية لمشغّلٍ واحد.

{
	email {$ACME_EMAIL}
	# لتجربة الإعداد بلا استهلاك حصة Let's Encrypt، أزل التعليق ثم أعده:
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

{$SITE_DOMAIN} {
	encode zstd gzip

	# ── ترويسات الأمان ──
	# منقولة حرفا بحرف عن vercel.json. أيّ نقصٍ هنا تراجعٌ أمنيّ صامت:
	# لا اختبار يحمرّ، ولا شاشة تتغيّر.
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# `worker-src 'self'` معلنةٌ صراحةً بقصد — لا زيادةً تجميليّة.
		# تركُها يجعل سفاري يرتدّ في سلسلة (worker-src ← child-src ← script-src)
		# ومعالجتُها معروفةٌ بثقوبها عنده، فيُرفض عاملُ الخدمة (`public/sw.js`)
		# بلا سببٍ ظاهر. وهو عطبٌ عولج مرّةً في `public/.htaccess` (طلبُ السحب ١٢)
		# ثمّ عاد حيّا هنا: `.htaccess` ملفُّ Apache و**Caddy لا يقرؤه**، فلمّا
		# صار الخادمُ على Hetzner خلف Caddy بقي العلاجُ في ملفٍّ لا يخدم شيئا.
		# والحارس: `src/tests/deploy/serving-headers.test.ts`
		Content-Security-Policy "default-src 'self'; worker-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; object-src 'none'; frame-src 'self' https://calendly.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# ── واجهة البرمجة ──
	# بلا أيّ تعديلٍ على الجسم. توقيع سترايب يُحسب على البايتات كما أرسلها،
	# فأيّ إعادة ترميزٍ أو ضغطٍ هنا تُسقط كل webhook.
	handle /api/* {
		reverse_proxy app:7101 {
			header_up X-Real-IP {remote_host}
		}
	}

	# ── توثيق واجهة البرمجة ──
	# **مغلقٌ على الإنتاج من الخادم نفسِه**، لا من هنا: `app.ts` لا يسجّل
	# صفحةَ Swagger إلّا خارج الإنتاج أو بـ`ENABLE_API_DOCS=true`. فهذه
	# الكتلةُ تُمرّر النداءَ فيجيب الخادمُ ٤٠٤ — وقد جُرّب في تمرين النشر
	# المحلّيّ (٤ سبتمبر): `GET /docs` عبر Caddy أجاب ٤٠٤.
	#
	# والتمريرُ يبقى بقصد: يومَ يحتاجها مطوّرٌ على الإنتاج تُفتَح بمتغيّرِ
	# بيئةٍ ثمّ تُغلَق، بلا لمسِ إعداد Caddy ولا نشرِ شيفرة.
	handle /docs* {
		reverse_proxy app:7101
	}

	# ── الواجهة الساكنة ──
	handle {
		root * /srv/web
		# الأصول مُبصمة بالمحتوى (index-Xq-pZg9a.js) فتُخزَّن للأبد بأمان
		@hashed path_regexp \.[0-9a-zA-Z_-]{8,}\.(js|css|woff2|png|jpg|svg)$
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		# وصفحاتُ HTML لا تُخزَّن أبدا: هي التي تدلّ على الأصول الجديدة.
		# والمقياسُ «مسارٌ بلا امتداد» لا قائمةُ مساراتٍ تُكتب بيد — فكلُّ صفحةٍ
		# مُهيَّأة (/pathways و/p/faq…) تُطلب بلا امتداد، والجذرُ كذلك.
		@html path /index.html
		@page not path_regexp \.[a-zA-Z0-9]+$
		header @html Cache-Control "no-cache"
		header @page Cache-Control "no-cache"

		# ── ولماذا `{path}.html` في الوسط ──
		#
		# كان السطرُ `try_files {path} /index.html` — فيردّ `index.html` نفسَه
		# لكلّ مسار. وذلك الملفُّ يحمل `canonical` الرئيسة، فكانت كلُّ صفحةٍ
		# تقول للزاحف «أصلي هو الرئيسة»؛ فطُويت صفحاتُ الموقع كلُّها في عنوانٍ
		# واحد ولم يظهر منها شيءٌ في قوقل. وهو العطبُ الذي وُلد لأجله
		# `scripts/prerender-seo.ts`: لكلّ صفحةٍ ملفُّها بوسومها.
		#
		# وملفٌّ `.html` لا مجلّدٌ بقصد: مجلّدُ `pathways/index.html` يجعل
		# الخادمَ يحوّل `/pathways` إلى `/pathways/` — عنوانا ثانيا بشرطةٍ
		# مائلةٍ يخالف `canonical` المُعلَن. والامتدادُ يتفادى التحويلَ كلَّه.
		#
		# والحارس: src/tests/seo/serving-prerendered.test.ts
		try_files {path} {path}.html /index.html
		file_server
	}

	log {
		output file /data/access.log {
			roll_size 20mb
			roll_keep 7
		}
	}
}
