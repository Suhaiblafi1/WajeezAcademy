# نسخة إلى deploy/.env.production على الخادم — ولا تُرفع إلى Git أبدا.
#   cp deploy/.env.production.example deploy/.env.production && chmod 600 deploy/.env.production
#
# .gitignore يستثني deploy/.env.production صراحةً. تحقّق قبل أول التزام.

# ── النطاق والشهادة ──
# ⚠️ النطاقُ الحيّ — منه يطلب Caddy الشهادة. وضعُ نطاقٍ لا يشير إلى هذا الخادم
# يجعل Let's Encrypt يرفض، فلا شهادةَ ولا موقع.
SITE_DOMAIN=www.wajeezacademy.com
# بريدٌ تصلك عليه تنبيهات Let's Encrypt قبل انتهاء الشهادة
ACME_EMAIL=Academy@wajeez.co

# ── قاعدة البيانات ──
# كلمة مرور طويلة عشوائية: openssl rand -base64 32
POSTGRES_USER=wajeez
POSTGRES_PASSWORD=
POSTGRES_DB=wajeez
# DATABASE_URL لا تُكتب هنا — compose.prod.yml يشتقّها من الثلاثة أعلاه

# ── أصل الموقع ──
# مصدر واحد لروابط الرسائل ورابط العودة من الدفع
APP_URL=https://www.wajeezacademy.com
# أصول CORS المسموحة، مفصولة بفاصلة. خطؤها يُسقط كل نداءات المتصفح.
WEB_ORIGIN=https://www.wajeezacademy.com

# ── التخزين ──
# اضبطه صراحةً ولا تتركه يُولَّد: التوليد التلقائي يكتبه في
# storage/private/.secret، وخادمٌ جديد يولّد غيره فتنكسر كل روابط الملفات
# الموقَّعة سابقا. openssl rand -hex 32
STORAGE_SECRET=

# ── الدفع ──
PAYMENT_DRIVER=stripe
# من لوحة سترايب: Developers ← Webhooks ← نقطتك ← Signing secret (whsec_…)
PAYMENT_WEBHOOK_SECRET=

# ── البريد ──
# مزوّد بريدٍ حقيقي — لا sendmail الخادم: نطاقات VPS محجوبة على نطاق واسع
RESEND_API_KEY=
RESEND_FROM_EMAIL=Academy@wajeez.co

# ── الجلسات ──
SESSION_TTL_DAYS=30

# ── النسخ الاحتياطي خارج الخادم ــ إلزامي ──
# وجهة rclone مُعدّة مسبقا على المضيف: rclone config
# مثال: wajeez-backup:wajeez/db
# deploy/backup.sh يرفض العمل بلا هذا المتغيّر — نسخةٌ على القرص نفسه ليست
# نسخةً احتياطية: عطبُ القرص يأخذ الاثنين معا.
BACKUP_REMOTE=
BACKUP_KEEP_DAYS=30

# ── اختياري ──
# ZOOM_WEBHOOK_SECRET=
# DEMO_MODE=
