# نسخة إلى deploy/.env.production على الخادم — ولا تُرفع إلى Git أبدا.
#   cp deploy/.env.production.example deploy/.env.production && chmod 600 deploy/.env.production
#
# .gitignore يستثني deploy/.env.production صراحةً. تحقّق قبل أول التزام.

# ── النطاق والشهادة ──
# ⚠️ النطاقُ الحيّ — منه يطلب Caddy الشهادة. وضعُ نطاقٍ لا يشير إلى هذا الخادم
# يجعل Let's Encrypt يرفض، فلا شهادةَ ولا موقع.
SITE_DOMAIN=www.wajeezacademy.com
# بريدٌ تصلك عليه تنبيهات Let's Encrypt قبل انتهاء الشهادة
ACME_EMAIL=Academy@wajeez.co

# ── قاعدة البيانات ──
# كلمة مرور طويلة عشوائية: openssl rand -base64 32
POSTGRES_USER=wajeez
POSTGRES_PASSWORD=
POSTGRES_DB=wajeez
# DATABASE_URL لا تُكتب هنا — compose.prod.yml يشتقّها من الثلاثة أعلاه

# ── أصل الموقع ──
# مصدر واحد لروابط الرسائل ورابط العودة من الدفع
APP_URL=https://www.wajeezacademy.com
# أصول CORS المسموحة، مفصولة بفاصلة. خطؤها يُسقط كل نداءات المتصفح.
WEB_ORIGIN=https://www.wajeezacademy.com

# ── التخزين ──
# اضبطه صراحةً ولا تتركه يُولَّد: التوليد التلقائي يكتبه في
# storage/private/.secret، وخادمٌ جديد يولّد غيره فتنكسر كل روابط الملفات
# الموقَّعة سابقا. openssl rand -hex 32
STORAGE_SECRET=

# ── الدفع ──
#
# ⚠️ الأربعةُ معا أو لا شيء. و`PAYMENT_DRIVER` وحدَه **يُفعّل الدفع**
#    (`integrations.service.ts:47` يضبط `enabled = true` بوجوده) — فضبطُه بلا
#    مفاتيحَ يجعل الدفعَ حيّا بلا اعتماد. وكان هذا الملفّ يذكر اثنين من أربعة.
#
# ⚠️ والبيئةُ تغلب لوحةَ الإدارة **حقلا حقلا** (`integrations.service.ts:45-50`).
#    فبعد ضبطها هنا، تعديلُها في `/admin/integrations` يبدو ناجحا ولا يفعل شيئا.
#    مصدرٌ واحدٌ لا اثنان — وهو هذا الملفّ في الإنتاج.
PAYMENT_DRIVER=stripe               # test | manual | moyasar | stripe
PAYMENT_PUBLISHABLE_KEY=            # pk_test_… (تجريبيّ) · pk_live_… (حيّ)
PAYMENT_SECRET_KEY=                 # sk_test_… (تجريبيّ) · sk_live_… (حيّ)
# من لوحة سترايب: Developers ← Webhooks ← نقطتك ← Signing secret (whsec_…)
# والعنوانُ المسجَّل هناك: https://www.wajeezacademy.com/api/webhooks/payments/stripe
# والحدث: checkout.session.completed
PAYMENT_WEBHOOK_SECRET=

# ⚠️⚠️ الانتقالُ من التجريبيّ إلى الحيّ: **أربعُ قيمٍ تتغيّر معا، أو لا شيء**
#
#   السائقُ نفسُه (`stripe`) يعمل بالمفاتيح التجريبيّة وبالحيّة سواءً — فلا
#   شيءَ في الشيفرة يعلن أيَّهما أنت فيه. والفارقُ في المفاتيح وحدَها.
#
#   ⚠️ **وسرُّ التوقيع يختلف بينهما.** سترايب يفصل نقطةَ الخطّاف التجريبيّةَ
#      عن الحيّة، ولكلٍّ `whsec_` خاصٌّ بها. وهذا الملفّ يحمل قيمةً واحدة
#      (`PAYMENT_WEBHOOK_SECRET`) — فمن يبدّل المفتاحَين ويترك سرَّ التوقيع
#      التجريبيَّ **يسقط كلُّ خطّافٍ حيٍّ بـ401**: المالُ يُقبض، والتسجيلُ لا
#      يُسوّى، والسجلُّ نظيفٌ لأنّ الطلبَ رُفض رفضا سليما. وهو أسوأُ ترتيب:
#      صامتٌ عندنا، صاخبٌ عند المشتري.
#
#   والترتيب: أنشئ نقطةَ خطّافٍ **حيّة** في سترايب على العنوان أعلاه، ثمّ
#   بدّل الأربعةَ دفعةً واحدة، ثمّ أعد التشغيل، ثمّ اشترِ شراءً حقيقيّا
#   واحدا وتحقّق أنّ التسجيلَ أُنشئ — لا أنّ الصفحة قالت «تمّ».

# ── البريد ──
# مزوّد بريدٍ حقيقي — لا sendmail الخادم: نطاقات VPS محجوبة على نطاق واسع
RESEND_API_KEY=
#
# ⚠️ **نطاقُ المُرسِل لا بدّ أن يكون النطاقَ المُوثَّق في Resend.** وResend
#    يرفض كلَّ رسالةٍ من نطاقٍ لم يُوثَّق عنده — والرفضُ يظهر في سجلّ الإشعار
#    لا في شاشةٍ حمراء. وهذا هو الافتراضُ في الشيفرة (`ACADEMY_EMAIL`)،
#    وهو نطاقُ الموقع نفسُه:
RESEND_FROM_EMAIL=no-reply@wajeezacademy.com
RESEND_REPLY_TO=support@wajeezacademy.com
#
# ⚠️ **وهذه المتغيّراتُ تغلب شاشةَ الإدارة حقلا حقلا** (`integrations.service.ts`
#    `:85-89`). فما ضُبط هنا لا يُغيَّر من `/admin/integrations` — يبدو الحفظُ
#    ناجحا ولا يفعل شيئا. فإن أردتَ إدارةَ البريد من الشاشة، **اترك
#    `RESEND_API_KEY` فارغا هنا** وضع المفتاحَ هناك.

# ── الجلسات ──
SESSION_TTL_DAYS=30

# ── النسخ الاحتياطي خارج الخادم ــ إلزامي ──
# وجهة rclone مُعدّة مسبقا على المضيف: rclone config
# مثال: wajeez-backup:wajeez/db
# deploy/backup.sh يرفض العمل بلا هذا المتغيّر — نسخةٌ على القرص نفسه ليست
# نسخةً احتياطية: عطبُ القرص يأخذ الاثنين معا.
BACKUP_REMOTE=
BACKUP_KEEP_DAYS=30

# ── اختياري ──
# ZOOM_WEBHOOK_SECRET=
# DEMO_MODE=
