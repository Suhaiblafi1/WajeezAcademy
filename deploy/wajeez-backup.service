# نسخة القاعدة الليلية. التثبيت:
#   sudo cp deploy/wajeez-backup.* /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now wajeez-backup.timer
#   systemctl list-timers wajeez-backup    للتأكّد من الموعد القادم
[Unit]
Description=نسخة احتياطية لقاعدة وجيز إلى تخزين خارج الخادم
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
# عدّل المسار إن استُنسخ المستودع في غير هذا الموضع
WorkingDirectory=/opt/wajeez
ExecStart=/usr/bin/bash deploy/backup.sh
# إخفاق النسخة يجب أن يُرى: journalctl -u wajeez-backup
StandardOutput=journal
StandardError=journal
