[Unit]
Description=تشغيل نسخة وجيز الاحتياطية يوميا

[Timer]
# ٠٣:٠٠ بتوقيت عمّان — أهدأ ساعة، وقبل بدء اليوم.
#
# والمنطقةُ مكتوبةٌ في الصيغة لا في التعليق وحدَه: `OnCalendar` بلا منطقةٍ
# تتبع ساعةَ الخادم، وخادمُ Hetzner الجديد على UTC — فكان التعليقُ يقول
# «٠٣:٠٠ بعمّان» والمؤقّتُ يعمل ٠٦:٠٠ بعمّان، أي في وقت بدء اليوم لا في
# أهدأ ساعة. قِيس بـ`systemd-analyze` لا بالقراءة:
#   systemd-analyze calendar "*-*-* 03:00:00"              ← 03:00 UTC = ٠٦:٠٠ عمّان
#   systemd-analyze calendar "*-*-* 03:00:00 Asia/Amman"   ← 00:00 UTC = ٠٣:٠٠ عمّان
# (المنطقةُ في الصيغة تحتاج systemd 240 أو أحدث — أوبنتو ٢٤٫٠٤ عليها ٢٥٥.)
OnCalendar=*-*-* 03:00:00 Asia/Amman
Persistent=true
# تشتيت دقيقتين: لا تتزاحم مع مهامّ أخرى على الدقيقة نفسها
RandomizedDelaySec=120

[Install]
WantedBy=timers.target
