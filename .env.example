# ═══ قاعدة البيانات ═══
# Docker:  postgresql://wajeez:wajeez_local@localhost:5432/wajeez
# مدمج محلي (بلا Docker): postgresql://wajeez:wajeez_local@localhost:5433/wajeez
# اتركها فارغة لتشغيل PostgreSQL المدمج تلقائيا
DATABASE_URL=

# ═══ خادم API ═══
API_PORT=7101
API_HOST=0.0.0.0
# سر الجلسات — غيّره في الإنتاج (مولّد عشوائي 32 بايت)
SESSION_SECRET=change-me-in-production-32-bytes-minimum
# مدة الجلسة بالأيام
SESSION_TTL_DAYS=30

# ═══ الواجهة ═══
# عنوان API الذي تقرأ منه الواجهة لقطة الكتالوج المنشورة
VITE_API_URL=http://localhost:7101

# ═══ تخزين الملفات الخاصة (S3/MinIO) ═══
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=wajeez-private
S3_ACCESS_KEY=wajeez
S3_SECRET_KEY=wajeez_local_minio

# ═══ البيئة: development | test | production ═══
NODE_ENV=development

# ═══ وضع الديمو — عرض محلي فقط، لا تفعّله في الإنتاج أبدا ═══
# DEMO_MODE=true      → يفعّل مسار الخادم POST /api/demo/switch-role (بدونه: 404 دائما)
# VITE_DEMO_MODE=true → يُظهر شريط مبدّل الأدوار في الواجهة (لا يظهر دون تأكيد الخادم أيضا)
# بعد التفعيل نفّذ مرة واحدة: npm run seed:demo
DEMO_MODE=false
VITE_DEMO_MODE=false
