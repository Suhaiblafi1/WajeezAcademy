# ─────────────────────────────────────────────────────────────
# أكاديمي وجيز — متغيرات البيئة (انسخ إلى .env عند النقل إلى Replit)
# لا تضع أي قيمة حقيقية هنا. التفاصيل الكاملة في docs/DEPLOYMENT.md
# ─────────────────────────────────────────────────────────────

# عنوان الموقع العام — يُستخدم في canonical وOG ورسائل البريد
APP_URL=https://academy.wajeez.com

# الدفع — Stripe (مفاتيح السر server-side فقط، لا تُمرر للمتصفح أبدا)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# الدخول الاجتماعي — OAuth حقيقي مختبَر قبل إظهار الأزرار (OAUTH_READY في src/services/auth.ts)
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
LINKEDIN_CLIENT_ID=...
LINKEDIN_CLIENT_SECRET=...

# البريد المعاملاتي (تأكيد الدفع، تفعيل الحساب، ردود التواصل)
# يتطلب ضبط SPF/DKIM/DMARC على النطاق قبل الإطلاق
SMTP_HOST=smtp.resend.com
SMTP_USER=resend
SMTP_PASS=...
MAIL_FROM="أكاديمي وجيز <no-reply@wajeez.co>"

# الدورات المباشرة عبر زووم — Server-to-Server OAuth
ZOOM_ACCOUNT_ID=...
ZOOM_CLIENT_ID=...
ZOOM_CLIENT_SECRET=...

# قناة واتساب الرسمية للمستشارين — الرقم بصيغة دولية بلا +
# عند ضبطه يظهر زر واتساب تلقائيا (حاليا يُعرض البريد بديلا)
WHATSAPP_BUSINESS_NUMBER=

# التحليلات — مزود يراعي الخصوصية (Plausible/PostHog)
ANALYTICS_PROVIDER=
ANALYTICS_API_KEY=
