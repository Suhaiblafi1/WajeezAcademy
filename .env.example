# متغيرات البيئة — أكاديمي وجيز (جاهزة للنقل إلى Replit)
# لا تضع أسرارا حقيقية هنا — انسخ إلى .env واملأ القيم.

# تكامل كتب وجيز (ملخصات صوتية واختباراتها داخل الدورات)
VITE_WAJEEZ_API_URL=
VITE_WAJEEZ_API_KEY=

# زووم — تُستخدم server-side فقط على Replit (لا تُعرّف بـ VITE_)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Stripe — مفتاح النشر فقط هنا؛ السري على الخادم
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# GoHighLevel — server-side فقط
GHL_API_KEY=
GHL_LOCATION_ID=
