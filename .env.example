# ═══ قاعدة البيانات ═══
# Docker:  postgresql://wajeez:wajeez_local@localhost:5432/wajeez
# مدمج محلي (بلا Docker): postgresql://wajeez:wajeez_local@localhost:5433/wajeez
# اتركها فارغة لتشغيل PostgreSQL المدمج تلقائيا
DATABASE_URL=

# ═══ خادم API ═══
API_PORT=7101
API_HOST=0.0.0.0
# سر الجلسات — غيّره في الإنتاج (مولّد عشوائي 32 بايت)
SESSION_SECRET=change-me-in-production-32-bytes-minimum
# مدة الجلسة بالأيام
SESSION_TTL_DAYS=30

# ═══ الواجهة ═══
# عنوان API الذي تقرأ منه الواجهة لقطة الكتالوج المنشورة
VITE_API_URL=http://localhost:7101

# ═══ تخزين الملفات الخاصة (S3/MinIO) ═══
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=wajeez-private
S3_ACCESS_KEY=wajeez
S3_SECRET_KEY=wajeez_local_minio

# ═══ البيئة: development | test | production ═══
NODE_ENV=development

# ═══ وضع الديمو — عرض محلي فقط، لا تفعّله في الإنتاج أبدا ═══
# DEMO_MODE=true      → يفعّل مسار الخادم POST /api/demo/switch-role (بدونه: 404 دائما)
# VITE_DEMO_MODE=true → يُظهر شريط مبدّل الأدوار في الواجهة (لا يظهر دون تأكيد الخادم أيضا)
# بعد التفعيل نفّذ مرة واحدة: npm run seed:demo  (تسعة حسابات، حساب لكل دور)
# DEMO_PASSWORD=…     → كلمة مرور حسابات الديمو عند البذر (الافتراضي Wajeez-Demo-2026)
DEMO_MODE=false
VITE_DEMO_MODE=false

# ═══ قناة البريد (SMTP) — توثيق البريد واستعادة كلمة المرور ورسائل المدربين ═══
#
# بلا هذه المفاتيح لا تُرسل المنصّة رسالة واحدة: يبقى شريط «بريدك غير موثَّق»
# بلا زرّ يعمل، ولا تصل رسالة استعادة كلمة المرور، ويمرّ طلب الشراء بلا توثيق
# بأثرٍ صريح (الحاجز لا يصير قفلا بلا مفتاح — انظر commerce.service.ts).
#
# وجود SMTP_HOST وحده يفعّل القناة. لا تضع هذه القيم في المستودع أبدا —
# مكانها متغيّرات البيئة في Vercel أو شاشة التكاملات في لوحة الإدارة.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM_NAME=أكاديمية وجيز
# SMTP_FROM_EMAIL=Academy@wajeez.co

# ═══ أصل الموقع العام — تُبنى عليه روابط الرسائل ═══
# بدونه تُبنى روابط التوثيق والاستعادة على localhost في الإنتاج.
# APP_URL=https://academy.wajeez.com

# ═══ الدفع — Stripe أو Moyasar ═══
#
# بلا مفتاح سرّي يعود النظام إلى المزوّد الاختباري **صامتا**: «نجاح» بلا مال.
# فبعد الوصل تحقّق من «فحص الاتصال الحي» في /admin/integrations ولا تكتفِ بأن
# الحفظ نجح. والدليل الكامل في docs/CONNECT_AR.md.
#
# انتبه للاسم: PAYMENT_WEBHOOK_SECRET لا STRIPE_WEBHOOK_SECRET.
# ولا تضع هذه القيم في المستودع — مكانها متغيّرات Vercel أو شاشة التكاملات.
# PAYMENT_DRIVER=stripe            # test | manual | moyasar | stripe
# PAYMENT_PUBLISHABLE_KEY=pk_live_…
# PAYMENT_SECRET_KEY=sk_live_…
# PAYMENT_WEBHOOK_SECRET=whsec_…
#
# عنوان الـwebhook الذي يُسجَّل عند المزوّد:
#   https://academy.wajeez.com/api/webhooks/payments/stripe
# والحدث المطلوب: checkout.session.completed

# ═══ العامل الخلفيّ — لا يعمل على Vercel ═══
#
# دالّةُ Vercel تستيقظ للطلب وتنام بعده، فلا موضعَ فيها لحلقةٍ تعمل كلَّ
# دقيقة. ولذلك يبقى طابورُ الإشعارات ممتلئا، ولا تُرسل تذكيراتُ الجلسات،
# ولا يُنفَّذ نشرٌ مجدول.
#
# والعاملُ مكتوبٌ ومُختبَرٌ (server/worker/) ولا يُشغَّل إلّا بهذا العلم على
# خادمٍ دائم — عمليّةٌ واحدةٌ إلى جانب الخادم:
#   WORKER_ENABLED=on npm run worker
# ودورةٌ واحدةٌ للفحص محلّيّا:
#   npm run worker:once
#
# وبلا العلم يطبع سببَ توقّفه ويخرج بنجاح — لا سقوطٌ يُقلق من شغّله بالخطأ.
# ونسختان لا تعملان معا: قفلٌ في القاعدة (pg_try_advisory_lock) يُخرج الثانية.
# WORKER_ENABLED=on
